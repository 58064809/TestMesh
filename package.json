{
  "name": "testmesh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reuse-first AI testing workbench",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build && node scripts/clean-server-build.mjs && tsc -p tsconfig.server.json && node scripts/copy-agent-skills.mjs",
    "build:client": "tsc -p tsconfig.app.json --noEmit && vite build",
    "build:server": "node scripts/clean-server-build.mjs && tsc -p tsconfig.server.json && node scripts/copy-agent-skills.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:ra:postgres": "tsx tests/requirement-analysis-postgres.integration.ts",
    "start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1",
    "start:stack": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-stack.ps1",
    "start:docling": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-docling.ps1",
    "start:phoenix": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-phoenix.ps1",
    "start:qdrant": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-qdrant.ps1",
    "setup:qdrant": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-qdrant.ps1",
    "aq01:spike": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-aq01-spike.ps1",
    "migrate:deepagents": "tsx scripts/migrate-deepagents.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@arizeai/openinference-core": "^2.8.0",
    "@arizeai/openinference-instrumentation-langchain": "^4.1.4",
    "@arizeai/openinference-instrumentation-openai": "^4.4.0",
    "@arizeai/phoenix-client": "^7.16.0",
    "@arizeai/phoenix-otel": "^2.2.0",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/openai": "^1.5.13",
    "@opentelemetry/api": "^1.9.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "@refinedev/core": "^5.0.12",
    "antd": "^5.29.3",
    "better-sqlite3": "^12.10.0",
    "deepagents": "^1.13.5",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "langchain": "^1.5.11",
    "multer": "^2.3.0",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
